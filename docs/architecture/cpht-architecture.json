  "cards": [
    { "dot": "cyan", "title": "Main path (v3.6/v3.7)", "items": [
      "cpht_compare prepares one shared calibration, then trains a selector (and optional value) by BPTT through the learned pH rollout",
      "Each decision plans 19 periodic-reference coefficients and solves a bounded six-motor QP",
      "Checkpoints go to runs/.../final.pt; reports to reports/"
    ] },
    { "dot": "emerald", "title": "Matched value learning (paper Sec. 4.7, comparison 2)", "items": [
      "fjbench agents share one backup: ct_sac, interval_euler (Euler step 2.19), ph_sac / ph_direct (App. F)",
      "The current requested hold is part of the policy input (see the review)"
    ] },
    { "dot": "amber", "title": "Reference audit", "items": [
      "Replays recorded checkpoints with privileged MuJoCo controllers; no training",
